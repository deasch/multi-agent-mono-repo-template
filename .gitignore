# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
.next/
out/

# Local overrides / agent-local files (covers */settings.local.json for any
# tool, e.g. .claude/settings.local.json, .cursor/settings.local.json)
*.local.md
*.local.json
*.local.yaml
*.local.yml
settings.local.json
.claude/settings.local.json
.devin/config.local.json

# Secrets & credentials of any kind
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc.local
credentials.json
service-account*.json
*_rsa
*_rsa.pub

# Private context lives in the private workspace, outside this repo (see
# private/README.md, "external" mode — the default). This is a
# defense-in-depth guard in case a real *.local.* file is ever accidentally
# created inside this repo's private/ directory — only the README and
# .example templates should exist here in that mode.
#
# If this repo instance uses "in-repo" mode instead (see private/README.md,
# "In-Repo Mode" — context.private.mode: "in-repo" in workspace.yaml),
# remove this line so real private/*.local.* files get committed.
private/*.local.*

# OS / editor
.DS_Store
*.log
.idea/

# Coverage
coverage/
