{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup workspace",
      "type": "shell",
      "command": "bash ${workspaceFolder}/scripts/setup.sh",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Read workspace config",
      "type": "shell",
      "command": "cat ${workspaceFolder}/workspace.yaml",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "List agent roles",
      "type": "shell",
      "command": "ls -1 ${workspaceFolder}/agents | grep -v README",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run workspace lint task",
      "type": "shell",
      "command": "sh -c \"$(grep '^lint:' ${workspaceFolder}/workspace.yaml | sed 's/^lint: //')\"",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Run workspace test task",
      "type": "shell",
      "command": "sh -c \"$(grep '^test:' ${workspaceFolder}/workspace.yaml | sed 's/^test: //')\"",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
